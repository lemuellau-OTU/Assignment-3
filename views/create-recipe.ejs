<%- include('partials/header') %>

<h1><%= recipe ? 'Edit Recipe' : 'Create New Recipe' %></h1>

<form action="<%= recipe ? '/edit/' + recipe._id : '/create' %>" method="POST">
  <input type="text" name="title" value="<%= recipe ? recipe.title : '' %>" placeholder="Title" required>
  <textarea name="ingredients" placeholder="Ingredients" required><%= recipe ? recipe.ingredients : '' %></textarea>
  <textarea name="instructions" placeholder="Instructions" required><%= recipe ? recipe.instructions : '' %></textarea>
  <button type="submit">Save</button>
</form>

<%- include('partials/footer') %>
