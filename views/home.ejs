<% include partials/header %>

<div class="container mt-4">
  <h1 class="mb-4">Recipe Sharing Site</h1>
  <a href="/create" class="btn btn-primary mb-3">Create New Recipe</a>
  <div class="list-group">
    <% recipes.forEach(recipe => { %>
      <div class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <h5><%= recipe.title %></h5>
          <p><%= recipe.ingredients.substring(0, 100) %>...</p>
        </div>
        <div>
          <a href="/edit/<%= recipe._id %>" class="btn btn-warning btn-sm">Edit</a>
          <form action="/delete/<%= recipe._id %>" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<% include partials/footer %>
