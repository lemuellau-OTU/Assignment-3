<!-- views/home.ejs -->
<!-- homepage -->

<%- include('partials/header') %>

<div class="container my-4">
  <h1 class="text-center mb-4">RepShare</h1>

  <!-- Button to create a new recipe -->
  <div class="text-center mb-4">
    <a href="/create" class="btn btn-primary btn-lg">Create New Recipe</a>
  </div>

  <!-- Recipe List -->
  <div class="row">
    <% recipes.forEach(recipe => { %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <div class="card-body">
            <h5 class="card-title"><%= recipe.title %></h5>
            <p class="card-text"><%= recipe.ingredients %></p>
          </div>
          <div class="card-footer text-center">
            <a href="/edit/<%= recipe._id %>" class="btn btn-warning btn-sm">Edit</a>
            <form action="/delete/<%= recipe._id %>" method="POST" style="display:inline;" onsubmit="return confirmDelete()">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
  function confirmDelete() {
    return confirm("Are you sure you want to delete this recipe?");
  }
</script>

<%- include('partials/footer') %>
