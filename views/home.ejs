<%- include('partials/header') %>

<h1>Recipe Sharing Site</h1>

<!-- Button to create a new recipe -->
<a href="/create" class="btn btn-primary mb-3">Create New Recipe</a>

<!-- Display the list of recipes -->
<ul>
  <% recipes.forEach(recipe => { %>
    <li class="list-group-item">
      <h3><%= recipe.title %></h3>
      <p><%= recipe.ingredients %></p>
      <!-- Edit button -->
      <a href="/edit/<%= recipe._id %>" class="btn btn-warning btn-sm">Edit</a>
      
      <!-- Delete form -->
      <form action="/delete/<%= recipe._id %>" method="POST" style="display:inline;">
        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
      </form>
    </li>
  <% }) %>
</ul>

<%- include('partials/footer') %>
