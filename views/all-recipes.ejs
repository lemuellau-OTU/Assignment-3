<!-- views/all-recipes.ejs -->
<!-- view all recipes -->

<%- include('partials/header') %>

<div class="container my-5">
  <h1 class="text-center mb-4">All Recipes</h1>

  <!-- Button to go back to the homepage -->
  <div class="text-center mb-4">
    <a href="/" class="btn btn-secondary btn-lg">Back to Home</a>
  </div>

  <!-- Recipe List -->
  <div class="row">
    <% recipes.forEach(recipe => { %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <h5 class="card-title text-primary"><%= recipe.title %></h5>
            <p class="card-text"><%= recipe.ingredients %></p>
          </div>
          <div class="card-footer text-center">
            <a href="/edit/<%= recipe._id %>" class="btn btn-warning btn-sm">Edit</a>
            <form action="/delete/<%= recipe._id %>" method="POST" style="display:inline;" onsubmit="return confirmDelete()">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
  function confirmDelete() {
    return confirm("Are you sure you want to delete this recipe?");
  }
</script>

<%- include('partials/footer') %>
